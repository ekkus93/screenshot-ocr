{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot OCR",
  "version": "0.1.0",
  "identifier": "io.github.ekkus93.screenshot-ocr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Screenshot OCR",
        "width": 920,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Utility",
    "shortDescription": "Copy visible screen text with local OCR",
    "longDescription": "Select a screen region, recognize text locally with Tesseract, and copy it to the clipboard.",
    "linux": {
      "deb": {
        "depends": ["gnome-screenshot", "tesseract-ocr", "tesseract-ocr-eng"]
      }
    }
  }
}
